# ===== Bắt buộc =====
# Local (docker compose up -d db):
DATABASE_URL=postgres://tuyn:tuyn_local_dev@localhost:5432/tuyntantam
# Neon: dùng chuỗi "direct" (không -pooler) cho migration; local để trống thì dùng DATABASE_URL
DATABASE_URL_UNPOOLED=
# URL công khai của site (không có dấu / cuối). Trên Vercel để trống → tự dùng tên miền production
# (tự đổi sang tên miền riêng khi gắn; nhớ Redeploy sau khi đổi tên miền)
APP_URL=http://localhost:3000
# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ===== Chỉ dùng khi chạy seed lần đầu (xoá sau khi tạo admin) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# ===== Tuỳ chọn =====
# Email nhận thông báo khi có khách liên hệ
LEAD_NOTIFY_EMAIL=
# Gửi email qua Resend (https://resend.com) — MAIL_FROM phải thuộc domain đã verify
RESEND_API_KEY=
MAIL_FROM=
# Upload ảnh lên Vercel Blob (tự có khi gắn Blob store trên Vercel); để trống → lưu vào UPLOAD_DIR
BLOB_READ_WRITE_TOKEN=
# Cloudflare Turnstile chống spam form (để trống → chỉ dùng honeypot + giới hạn tần suất)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Origin ngoài được phép gọi API (phân tách dấu phẩy), mặc định chỉ same-origin
CORS_ORIGINS=
# Lấy IP khách để giới hạn tần suất: tự là "vercel" trên Vercel; Docker/VPS sau nginx/Caddy để "proxy" (mặc định)
TRUST_PROXY=

# Thư mục lưu ảnh upload khi không dùng Vercel Blob (mặc định ./storage/uploads)
UPLOAD_DIR=

# Vercel: bản Preview mặc định KHÔNG chạy migration; đặt 1 nếu Preview dùng DB riêng (Neon branch)
MIGRATE_ON_PREVIEW=
